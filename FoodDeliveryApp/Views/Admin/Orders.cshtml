@using FoodDeliveryApp.ViewModels
@{ Layout = "~/Views/Shared/_AdminLayout.cshtml"; ViewData["Title"] =
"Today's Orders"; }

@* Auto-refresh toutes les 60 secondes *@ 
<meta http-equiv="refresh" content="60" />

<div class="container mt-4">
    <h2>@ViewData["Title"]</h2>
    <small class="text-muted">The page refreshes every 60 seconds.</small>

    <!-- Onglets de navigation -->
    <ul class="nav nav-tabs" id="ordersTab">
        <li class="nav-item">
            <button class="nav-link active" data-bs-toggle="tab" data-bs
                    target="#pendingTab">
                Pending Orders
            </button>
        </li>
        <li class="nav-item">
            <button class="nav-link" data-bs-toggle="tab" data-bs
                    target="#acceptedTab">
                Accepted Orders
            </button>
        </li>
        <li class="nav-item">
            <button class="nav-link" data-bs-toggle="tab" data-bs
                    target="#rejectedTab">
                Rejected Orders
            </button>
        </li>
    </ul>

    <div class="tab-content border border-top-0 p-3">
        <!-- Onglet Pending avec boutons Accept/Reject -->
        <div class="tab-pane fade show active" id="pendingTab">
            @foreach (var order in
                        (List<AdminOrdersViewModel>)ViewBag.PendingOrders)
            {
                <!-- Bouton Accept -->
                <form asp-controller="Admin" asp-action="AcceptOrder"
                      method="post" class="d-inline">
                    <input type="hidden" name="orderId" value="@order.OrderId" />
                    <button class="btn btn-success btn-sm">Accept</button>
                </form>
                <!-- Bouton Reject -->
                <form asp-controller="Admin" asp-action="RejectOrder"
                      method="post" class="d-inline">
                    <input type="hidden" name="orderId" value="@order.OrderId" />
                    <button class="btn btn-danger btn-sm">Reject</button>
                </form>
            }
        </div>
        <!-- Onglets Accepted et Rejected : même structure sans boutons Actions -->
    </div>
</div>
