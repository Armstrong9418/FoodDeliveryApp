@* Navbar conditionnelle : n'affiche les liens QUE si l'admin est connecté 
*@ 
@if (User?.Identity?.IsAuthenticated == true && User.IsInRole("Admin")) 
{ 
    <ul class="navbar-nav mr-auto"> 
        <li><a class="nav-link" asp-controller="Admin" asp
action="Products">Products</a></li> 
        <li><a class="nav-link" asp-controller="Admin" asp
action="Orders">Orders</a></li> 
    </ul> 
    @* Bouton Logout *@ 
    <li><a class="nav-link" asp-controller="AdminAccount" asp
action="Logout">Logout</a></li> 
} 
else
{
<li>
    <a class="nav-link" asp-controller="AdminAccount" asp
       action="Login">Login</a>
</li>
} 