@{
    ViewData["Title"] = "Home Page"; Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- Hero Section avec image de fond -->
<div class="hero-section" style="background:
    url('https://images.unsplash.com/photo-1565299624946-b28f40a0ae38') no-repeat
center;
    background-size:cover; min-height:300px; position:relative;">
    <div style="position:absolute;top:0;left:0;width:100%;height:100%;background:rgba(0,0,
0,0.6)"></div>
    <div class="container text-center" style="position:relative;z
index:2;padding-top:80px">
        <h1 class="display-4 text-white">Fast. Fresh. Delivered.</h1>
        <p class="lead text-white">Experience the best in food delivery...</p>
        <a href="@Url.Action("PlaceOrder", "Customer")" class="btn btn-lg btn
primary mt-3">Order Now</a>
    </div>
</div>

<!-- 3 feature cards -->
<div class="container my-3">
    <div class="row text-center">
        <div class="col-md-4"><h4>Lightning Fast Delivery</h4><p>...</p></div>
        <div class="col-md-4"><h4>Diverse Cuisines</h4><p>...</p></div>
        <div class="col-md-4"><h4>Top-Rated Restaurants</h4><p>...</p></div>
    </div>
</div>

<div class="container text-center my-3">
    <a href="@Url.Action("Register", "CustomerAccount")" class="btn btn-lg btn
success">Sign Up Now</a>
</div> 