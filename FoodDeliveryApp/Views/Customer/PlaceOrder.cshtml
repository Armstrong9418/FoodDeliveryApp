@model FoodDeliveryApp.ViewModels.MultipleOrderItemViewModel
@{ Layout = "~/Views/Shared/_CustomerLayout.cshtml"; ViewData["Title"] = 
"Place an Order"; } 
 
<div class="container mt-4"> 
  <div class="card"> 
    <div class="card-header bg-primary text-white"><h5>Place an Order</h5></div> 
    <div class="card-body"> 
      <form asp-action="PlaceOrder" method="post">
      <p class="text-muted">Select quantities. Items with "0" will be ignored.</p>
                <table class="table table-bordered table-hover">
                    <thead>
                        <tr>
                            <th>
                                Item
                                Name
                            </th>
                            <th>Price</th>
                            <th>Quantity</th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (int i = 0; i < Model.Items.Count; i++)
                        {
                            <tr>
                                <td>@Model.Items[i].ItemName</td>
                                <td>@Model.Items[i].Price.ToString("C")</td>
                                <td>
                                    <!-- CRUCIAL : asp-for avec index [i] pour le binding de
                                    liste -->
                                    <input asp-for="@Model.Items[i].Quantity" class="form control" min="0" />
                                    <!-- ItemId en caché pour identifier le plat dans le POST -->
                                    <input asp-for="@Model.Items[i].ItemId" type="hidden" />
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
                <button type="submit" class="btn btn-success">Place Order</button>
            </form>
        </div>
    </div>
</div>

